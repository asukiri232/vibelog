# Локальная разработка (скопируйте в .env при необходимости)
DJANGO_SECRET_KEY=change-me-to-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Railway / Render / Neon — PostgreSQL (на Railway подставляется автоматически)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Railway (опционально)
# DJANGO_DEBUG=false
# SEED_DEMO=1
# SERVE_MEDIA=true
# MEDIA_ROOT=/app/mysite/media

# Render
# RENDER_EXTERNAL_HOSTNAME=
